{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "composite": false,
    "noEmit": true,
    "moduleResolution": "bundler",
    "types": ["bun", "node"],
    "allowJs": true
  },
  "include": ["build.ts", "src/**/*.ts"]
}
