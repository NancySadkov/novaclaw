{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "novaclaw",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test --timeout 30000 --only-failures",
    "bench:test": "bun run script/bench-test-suite.ts",
    "profile:test": "bun run script/profile-test-files.ts",
    "build": "bun run script/build.ts",
    "dev": "bun run --conditions=browser ./src/index.ts",
    "dev:temporary": "bun run --conditions=browser ./src/temporary.ts"
  },
  "bin": {
    "nova-cli": "./bin/novaclaw"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#db": {
      "bun": "./src/storage/db.bun.ts",
      "node": "./src/storage/db.node.ts",
      "default": "./src/storage/db.bun.ts"
    }
  },
  "devDependencies": {
    "@novaclaw/core": "workspace:*",
    "@novaclaw/script": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/json-schema": "7.0.15",
    "@types/mime-types": "3.0.1",
    "@types/npm-package-arg": "6.1.4",
    "@types/qrcode": "1.5.5",
    "@types/semver": "^7.5.8",
    "@types/yargs": "17.0.33",
    "@typescript/native-preview": "catalog:",
    "drizzle-orm": "catalog:",
    "prettier": "3.6.2",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@clack/prompts": "1.0.0-alpha.1",
    "@effect/platform-node": "catalog:",
    "@ff-labs/fff-bun": "0.9.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@novaclaw/llm": "workspace:*",
    "@novaclaw/plugin": "workspace:*",
    "@novaclaw/protocol": "workspace:*",
    "@novaclaw/schema": "workspace:*",
    "@novaclaw/script": "workspace:*",
    "@novaclaw/sdk": "workspace:*",
    "@novaclaw/server": "workspace:*",
    "@parcel/watcher": "2.5.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "bonjour-service": "1.3.0",
    "cross-spawn": "catalog:",
    "diff": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "extract-zip": "2.0.1",
    "gray-matter": "4.0.3",
    "ignore": "7.0.5",
    "jsonc-parser": "3.3.1",
    "mime-types": "3.0.2",
    "npm-package-arg": "13.0.2",
    "open": "10.1.2",
    "qrcode": "1.5.4",
    "remeda": "catalog:",
    "semver": "^7.6.3",
    "strip-ansi": "7.1.2",
    "yargs": "18.0.0",
    "zod": "catalog:"
  },
  "overrides": {
    "drizzle-orm": "catalog:"
  }
}
