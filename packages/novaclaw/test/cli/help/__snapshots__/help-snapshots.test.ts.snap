// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`novaclaw CLI help-text snapshots every documented command emits stable help text: novaclaw mcp --help 1`] = `
"nova-cli mcp

manage MCP (Model Context Protocol) servers

Commands:
  nova-cli mcp add [name]     add an MCP server
  nova-cli mcp list           list MCP servers and their status                        [aliases: ls]
  nova-cli mcp auth [name]    authenticate with an OAuth-enabled MCP server
  nova-cli mcp logout [name]  remove OAuth credentials for an MCP server
  nova-cli mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`novaclaw CLI help-text snapshots every documented command emits stable help text: novaclaw run --help 1`] = `
"nova-cli run [message..]

run novaclaw with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help                          show help                                            [boolean]
  -v, --version                       show version number                                  [boolean]
      --print-logs                    print logs to stderr                                 [boolean]
      --log-level                     log level [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure                          run without external plugins                         [boolean]
      --command                       the command to run, use message for args              [string]
  -c, --continue                      continue the last session                            [boolean]
  -s, --session                       session id to continue                                [string]
      --fork                          fork the session before continuing (requires --continue or
                                      --session)                                           [boolean]
  -m, --model                         model to use in the format of provider/model          [string]
      --agent                         agent to use                                          [string]
      --format                        format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file                          file(s) to attach to message                           [array]
      --title                         title for the session (uses truncated prompt if no value
                                      provided)                                             [string]
      --attach                        attach to a running novaclaw server (e.g.,
                                      http://localhost:4096)                                [string]
  -p, --password                      basic auth password (defaults to NOVACLAW_SERVER_PASSWORD)
                                                                                            [string]
  -u, --username                      basic auth username (defaults to NOVACLAW_SERVER_USERNAME or
                                      'novaclaw')                                           [string]
      --dir                           directory to run in, path on remote server if attaching
                                                                                            [string]
      --port                          port for the local server (defaults to random port if no value
                                      provided)                                             [number]
      --variant                       model variant (provider-specific reasoning effort, e.g., high,
                                      max, minimal)                                         [string]
      --thinking                      show thinking blocks                                 [boolean]
      --dangerously-skip-permissions  auto-approve permissions that are not explicitly denied
                                      (dangerous!)                        [boolean] [default: false]"
`;

exports[`novaclaw CLI help-text snapshots every documented command emits stable help text: novaclaw debug --help 1`] = `
"nova-cli debug

debugging and troubleshooting tools

Commands:
  nova-cli debug config        show resolved configuration
  nova-cli debug rg            ripgrep debugging utilities
  nova-cli debug file          file system debugging utilities
  nova-cli debug skill         list all available skills
  nova-cli debug snapshot      snapshot debugging utilities
  nova-cli debug startup       print startup timing
  nova-cli debug agent <name>  show agent configuration details
  nova-cli debug v2            debug v2 catalog and built-in plugins
  nova-cli debug info          show debug information
  nova-cli debug paths         show global paths (data, config, cache, state)
  nova-cli debug wait          wait indefinitely (for debugging)

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

