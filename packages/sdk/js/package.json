{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@novaclaw/sdk",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "build": "bun ./script/build.ts",
    "regen": "bun ./script/build.ts && cd ../../novaclaw && bun dev generate > ../sdk/openapi.json",
    "check:generated": "bun run regen && git diff --exit-code -- ../openapi.json src/v2/gen"
  },
  "exports": {
    "./v2": "./src/v2/index.ts",
    "./v2/client": "./src/v2/client.ts",
    "./v2/gen/client": "./src/v2/gen/client/index.ts",
    "./v2/types": "./src/v2/gen/types.gen.ts"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
