    "@novaclaw/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@novaclaw/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@novaclaw/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
