{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "NOVACLAW_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "NOVACLAW_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "novaclaw#test": {
      "dependsOn": ["^build"],
      "outputs": [],
